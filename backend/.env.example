# Neon Postgres (or any PostgreSQL) — required for durable checkpoints in production.
# Prefer Neon's "pooled" / pooler connection string (host often contains "-pooler") for serverless + long-lived pools.
# For local dev without a DB, leave empty to use in-memory checkpointer.
# No spaces around "=". Use a full LiteLLM id (anthropic/...) or a bare OpenAI name (we prefix openai/).
DATABASE_URL=

OPENAI_API_KEY=

# Examples: gpt-4o-mini | gpt-4.1-mini | openai/gpt-4o (explicit provider)
LITELLM_DEFAULT_MODEL=gpt-4o-mini

# Optional — Alpha Vantage API key for stock lookup (symbol search + daily time series).
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
